# Puerto del servidor
PORT=3400

# Conexion a la base de datos PostgreSQL
DB_URL=postgresql://postgres:admin@localhost:5433/notificaciones?schema=public

# Entorno de ejecucion (development | production)
ENVIRONMENT=development

# Numero de saltos (rounds) de bcrypt
SALT_PSWD=10

# Firmas para los tokens JWT (cambiar en produccion)
FIRMA_ACCESS_TOKEN=cambiar_este_secret_de_access_en_produccion
FIRMA_REFRESH_TOKEN=cambiar_este_secret_de_refresh_en_produccion

# Duracion de los tokens
ACCESS_TOKEN_DURATION=24h
REFRESH_TOKEN_DURATION=7d
