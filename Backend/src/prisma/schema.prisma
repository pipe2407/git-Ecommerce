generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USUARIOS & SEGURIDAD
// ============================================================
model usuarios {
  id                BigInt   @id @default(autoincrement())
  nombre            String   @db.VarChar(200)
  email             String   @unique @db.VarChar(200)
  password          String
  rol_id            BigInt
  estado            Boolean  @default(true)
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  rol                    roles                          @relation(fields: [rol_id], references: [id])
  notificacionesEnviadas modulonotificaciones[]         @relation("usuarioRemitente")
  respuestas             hiloRespuestaNotificacion[]
  destinatarios          notificacionesvsdestinatario[]
  auditoria              auditoria[]
  productosPublicados    productos[]                    @relation("productosPublicados")
  ordenesComprador       ordenes[]                      @relation("ordenesComprador")
}

model roles {
  id                BigInt   @id @default(autoincrement())
  nombre            String   @unique @db.VarChar(100)
  descripcion       String?
  estado            Boolean  @default(true)
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  usuarios usuarios[]
  permisos permisos[] @relation("rolPermisos")
}

model permisos {
  id                BigInt   @id @default(autoincrement())
  nombre            String   @unique @db.VarChar(100)
  descripcion       String?
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  roles roles[] @relation("rolPermisos")
}

// ============================================================
// NOTIFICACIONES (CORE)
// ============================================================
model modulonotificaciones {
  id                BigInt   @id @default(autoincrement())
  asunto            String   @db.VarChar(500)
  descripcion       String
  tipo_id           BigInt
  estado_id         BigInt
  categoria_id      BigInt
  usuario_id        BigInt
  plazo             String?  @db.VarChar(50)
  trimestre         Int?
  anioReporte       Int?
  entidad           String?  @db.VarChar(200)
  sector            String?  @db.VarChar(200)
  adjunto           String?
  textoNotificacion String?
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  tipo          tiponotificaciones             @relation(fields: [tipo_id], references: [id])
  estado        estadonotificacion             @relation(fields: [estado_id], references: [id])
  categoria     categoria                      @relation(fields: [categoria_id], references: [id])
  usuario       usuarios                       @relation("usuarioRemitente", fields: [usuario_id], references: [id])
  respuestas    hiloRespuestaNotificacion[]
  destinatarios notificacionesvsdestinatario[]
}

model tiponotificaciones {
  id                BigInt   @id @default(autoincrement())
  nombre            String   @unique @db.VarChar(100)
  descripcion       String?
  estado            Boolean  @default(true)
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  notificaciones modulonotificaciones[]
}

model estadonotificacion {
  id                BigInt   @id @default(autoincrement())
  nombre            String   @unique @db.VarChar(50)
  descripcion       String?
  estado            Boolean  @default(true)
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  notificaciones modulonotificaciones[]
}

model categoria {
  id                BigInt   @id @default(autoincrement())
  nombre            String   @unique @db.VarChar(100)
  descripcion       String?
  estado            Boolean  @default(true)
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  notificaciones modulonotificaciones[]
  productos      productos[]
}

model hiloRespuestaNotificacion {
  id                BigInt   @id @default(autoincrement())
  notificacion_id   BigInt
  usuario_id        BigInt
  mensaje           String
  adjunto           String?
  estado            Boolean  @default(true)
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  notificacion modulonotificaciones @relation(fields: [notificacion_id], references: [id], onDelete: Cascade)
  usuario      usuarios             @relation(fields: [usuario_id], references: [id])
}

model notificacionesvsdestinatario {
  id                BigInt    @id @default(autoincrement())
  notificacion_id   BigInt
  usuario_id        BigInt
  leida             Boolean   @default(false)
  fechaLectura      DateTime?
  fechaCreacion     DateTime  @default(now())
  fechaModificacion DateTime  @updatedAt

  notificacion modulonotificaciones @relation(fields: [notificacion_id], references: [id], onDelete: Cascade)
  usuario      usuarios             @relation(fields: [usuario_id], references: [id])
}

model auditoria {
  id            BigInt   @id @default(autoincrement())
  usuario_id    BigInt
  accion        String   @db.VarChar(500)
  entidad       String   @db.VarChar(100)
  entidadId     BigInt
  detalles      String?
  fechaCreacion DateTime @default(now())

  usuario usuarios @relation(fields: [usuario_id], references: [id])
}

// ============================================================
// PRODUCTOS & COMPRAS
// ============================================================
model productos {
  id                BigInt   @id @default(autoincrement())
  nombre            String   @db.VarChar(200)
  descripcion       String
  precio            Decimal  @db.Decimal(12, 2)
  precioOriginal    Decimal? @db.Decimal(12, 2)
  imagen            String?
  categoria_id      BigInt
  usuario_id        BigInt
  stock             Int      @default(0)
  estado            Boolean  @default(true)
  sku               String?  @db.VarChar(100)
  marca             String?  @db.VarChar(100)
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt

  categoria categoria    @relation(fields: [categoria_id], references: [id])
  publicador usuarios    @relation("productosPublicados", fields: [usuario_id], references: [id])
  ordenes   ordenes[]
}

model ordenes {
  id                  BigInt   @id @default(autoincrement())
  producto_id         BigInt
  comprador_id        BigInt
  cantidad            Int      @default(1)
  precioTotal         Decimal  @db.Decimal(12, 2)
  estado              String   @default("pendiente") @db.VarChar(50)
  nombreComprador     String?  @db.VarChar(200)
  emailComprador      String?  @db.VarChar(200)
  direccion           String?
  ciudad              String?  @db.VarChar(100)
  departamento        String?  @db.VarChar(100)
  codigoPostal        String?  @db.VarChar(20)
  telefonoComprador   String?  @db.VarChar(20)
  metodoPago          String?  @db.VarChar(50)
  numeroTarjeta       String?  @db.VarChar(20)
  nombreTitular       String?  @db.VarChar(200)
  fechaVencimiento    String?  @db.VarChar(5)
  fechaCreacion       DateTime @default(now())
  fechaModificacion   DateTime @updatedAt

  producto  productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  comprador usuarios  @relation("ordenesComprador", fields: [comprador_id], references: [id])
}
